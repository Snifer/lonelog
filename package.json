		"esbuild": "0.25.5",
		"eslint-plugin-obsidianmd": "^0.1.8",
		"globals": "14.0.0",
		"jest": "^25.0.0",
		"jiti": "2.6.1",
		"ts-jest": "^27.0.3",
		"ts-node": "^10.9.2",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.71.1"
	},
	"dependencies": {
		"@codemirror/state": "6.5.0",
